{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "importOrder": [
    "^react$",
    "^@chakra-ui",
    "<THIRD_PARTY_MODULES>",
    "<THIRD_PARTY_TYPES>",
    "^@idiq-micro",
    "^[./]",
    "<TYPE>^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
